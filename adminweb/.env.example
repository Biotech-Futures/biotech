# The Django API and both local frontends must use the same 127.0.0.1 host.
# Do not mix localhost and 127.0.0.1: cross-origin session cookies and CSRF
# requests must resolve against one consistent API host, and Django CORS must
# allow both local frontend origins. Without this key, adminweb defaults to
# localhost:8000, which does not share the 127.0.0.1 browser session.
VITE_PUBLIC_API_URL=http://127.0.0.1:8000

# Temporary trusted Vue intake embedded by the authenticated People tab.
# Local example: http://127.0.0.1:5174/#/supervisor/registration/embed
# The Vue app also needs VITE_ADMIN_FRONTEND_URL=http://127.0.0.1:3001 locally;
# otherwise its admin handoff defaults to mentoringadmin.biotechfutures.org.
VITE_REGISTRATION_INTAKE_URL=
