# .env.example

# --- API Configuration ---
# The base URL for the backend API services.
# Registration uses the current origin when this is empty.
# For a separately hosted backend, set the deployed server origin.
VITE_API_BASE_URL=
VITE_ADMIN_FRONTEND_URL=https://mentoringadmin.biotechfutures.org

# Optional override of the authoritative registration endpoint.
# Default: ${VITE_API_BASE_URL}/api/v1/registration (no trailing slash).
# This requires the approved multi-journey intake; there is no legacy/demo fallback.
# Success: receipt or {"data": receipt}, with reference_code/referenceCode,
# journey, student_count/studentCount, and created_at/submittedAt.
# Error: {"error":"...", "code":"...", "request_id":"...", "fields":{"field.path":["..."]}}
# HTTP 400 warnings: {"warnings":[{"code":"...", "field":"students.0.school",
# "override_field":"students.0.overrides.ConfirmSchoolOverride", "message":"..."}]}
VITE_REGISTRATION_API_URL=

# --- Other Configurations (Add as needed) ---
# VITE_APP_NAME="Your Project Name"
