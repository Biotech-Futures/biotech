# .env.example

# --- API Configuration ---
# The base URL for the backend API services.
# Local development default: http://localhost:8000
# For production/deployment: Replace with the actual server URL
VITE_API_BASE_URL=http://localhost:8000

# The React admin console the sidebar's "Admin Portal" link opens (admins only).
# Defaults to the production domain; point at a local adminweb dev server if needed.
# VITE_ADMIN_FRONTEND_URL=http://localhost:3000

# Optional registration endpoint override; default: ${VITE_API_BASE_URL}/api/v1/registration.
# The production adapter currently accepts individual/late-link students only.
# Team, supervisor, CSV and mentor forms remain visible but fail explicitly on submission.
# Requests require session credentials, CSRF and a UUID Idempotency-Key.
# Success must be a saved receipt, never a simulated response or legacy body echo.
VITE_REGISTRATION_API_URL=

# --- Other Configurations (Add as needed) ---
# VITE_APP_NAME="Your Project Name"
